# Confluence Server
CONFLUENCE_BASE_URL=http://your-confluence-server:8090
CONFLUENCE_PAT=your-personal-access-token-here
CONFLUENCE_SPACE_KEY=YOURSPACE

# Local AI — embedding and chat served from same OpenAI-compatible server
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_API_KEY=dummy

# If embedding and chat are on different servers, override here:
# LOCAL_EMBED_BASE_URL=http://embed-server:8001/v1
# LOCAL_CHAT_BASE_URL=http://chat-server:8002/v1

# Database
DB_URL=jdbc:postgresql://localhost:5432/confluencebot
DB_USERNAME=confluencebot
DB_PASSWORD=confluencebot
