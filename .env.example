# =============================================================================
# Confluence RAG Chatbot — Environment Configuration
# Copy this file to .env and fill in your values before running the app.
# =============================================================================

# -----------------------------------------------------------------------------
# Confluence Server
# -----------------------------------------------------------------------------
CONFLUENCE_BASE_URL=http://your-confluence-server:8090
CONFLUENCE_PAT=your-personal-access-token-here
CONFLUENCE_SPACE_KEY=YOURSPACE

# Optional tuning (defaults shown)
# CONFLUENCE_PAGE_FETCH_LIMIT=250
# CONFLUENCE_REQUEST_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# AI — OpenAI-compatible endpoints (Ollama, LM Studio, vLLM, OpenAI, etc.)
#
# Three jobs, three models: writing the answer, embedding text, and ranking the
# retrieved excerpts. Each can have its own endpoint, model and API key; each
# falls back to AI_BASE_URL / AI_API_KEY when you don't give it one. One local
# server for everything needs only the two shared values below.
# -----------------------------------------------------------------------------
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=dummy

CHAT_MODEL=openai/llama-4-17b-maverick
EMBED_MODEL=openai/snowflake-arctic

# Optional tuning (defaults shown)
# CHAT_TEMPERATURE=0.1
# CHAT_MAX_TOKENS=2048

# --- Per-role endpoints and keys (all optional; blank = use the shared ones) ---
# Answering. Point this at a hosted model and leave embedding on the local box:
# CHAT_BASE_URL=https://api.openai.com/v1
# CHAT_API_KEY=sk-...

# Embedding. Changing the model or the server invalidates every vector already
# stored — re-ingest afterwards, and keep the dimensions at 1024.
# EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_API_KEY=dummy

# Re-ranking: one short call that orders the retrieved excerpts before the answer
# is written. It emits "3,1,2", never prose, so a small fast model does it well
# and keeps the wait before the first token down. Unset, it reuses the chat model.
# RERANK_BASE_URL=http://localhost:11434/v1
# RERANK_API_KEY=dummy
# RERANK_MODEL=qwen2.5:3b
# RERANK_TEMPERATURE=0.0            # ranking should be repeatable
# RERANK_MAX_TOKENS=64              # raise it for a model that thinks aloud
# CHAT_RERANK_LLM_ENABLED=true      # off: keep the MMR order, skip the call

# -----------------------------------------------------------------------------
# Chat retrieval
# -----------------------------------------------------------------------------
# CHAT_TOP_K=5
# CHAT_SIMILARITY_THRESHOLD=0.70

# -----------------------------------------------------------------------------
# Conversation context — what a follow-up question is answered in the light of
# -----------------------------------------------------------------------------
# CHAT_CONTEXT_ENABLED=true               # off: every question is answered on its own
# CHAT_CONTEXT_MAX_EXCHANGES=6            # previous Q&A pairs carried into the next turn
# CHAT_CONTEXT_MAX_ANSWER_CHARS=1200      # characters kept of each previous answer
# CHAT_CONTEXT_REWRITE_ENABLED=true       # condense a follow-up into a standalone search query
# CHAT_CONTEXT_REWRITE_TIMEOUT=PT3S       # ceiling on the latency the rewrite can add
# CHAT_CONTEXT_REWRITE_MAX_CHARS=400      # longer replies are a model answering, not rewriting
# CHAT_CONTEXT_CORE_POOL_SIZE=2
# CHAT_CONTEXT_MAX_POOL_SIZE=8            # never queues: no free thread means search as typed

# -----------------------------------------------------------------------------
# Answer streaming and conversations
# -----------------------------------------------------------------------------
# CHAT_STREAM_TIMEOUT=PT3M            # how long one streamed answer may take
# CHAT_STREAM_CORE_POOL_SIZE=4        # threads reserved for streaming answers
# CHAT_STREAM_MAX_POOL_SIZE=16
# CHAT_STREAM_QUEUE_CAPACITY=16       # beyond this, callers are told the bot is busy
# CHAT_LLM_MAX_ATTEMPTS=3             # retries for a non-streamed completion
# CHAT_LLM_INITIAL_BACKOFF_MS=500
# CHAT_ABANDONED_SESSION_TTL=PT1H     # untouched, unnamed conversations are cleaned up after this
# ASYNC_REQUEST_TIMEOUT_MS=240000     # servlet async backstop; keep above CHAT_STREAM_TIMEOUT

# -----------------------------------------------------------------------------
# Database
# When running locally (outside Docker): point to localhost.
# Docker Compose overrides DB_URL automatically to reach the postgres service.
# -----------------------------------------------------------------------------
DB_NAME=confluencebot
DB_USERNAME=confluencebot
DB_PASSWORD=confluencebot
DB_URL=jdbc:postgresql://localhost:5432/confluencebot

# Optional — override the host port Docker Compose binds (default 5432)
# DB_PORT=5432

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# APP_PORT=8080

# Optional — override log levels
# LOG_LEVEL_APP=INFO
# LOG_LEVEL_SPRING_AI=WARN
# LOG_LEVEL_FLYWAY=INFO

# Optional — connection pool tuning (defaults shown)
# DB_POOL_MAX_SIZE=10
# DB_POOL_MIN_IDLE=2

# -----------------------------------------------------------------------------
# Authentication (JWT)
# Generate a strong secret: openssl rand -base64 64
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-generate-a-strong-base64-secret-at-least-64-chars-long
# JWT_EXPIRATION_MS=900000            # access token lifetime, 15 minutes (default)
# JWT_REFRESH_TOKEN_TTL=P30D          # refresh token lifetime, ISO-8601 duration

# Browser origins allowed to call the API. The frontend calls this service directly at its own
# absolute URL (VITE_API_BASE below) rather than through a same-origin proxy, so set this to the
# UI's real origin(s) in anything but a throwaway local setup.
# CORS_ALLOWED_ORIGINS=https://bot.example.com

# Default admin credentials are set via DB migration V6:
#   email: admin@confluencebot.local
#   password: Admin@1234  (must be changed on first login)

# -----------------------------------------------------------------------------
# Single sign-on — any OAuth 2.0 / OpenID Connect provider
#
# Off by default. Switched on, the sign-in screen grows a "Continue with <name>"
# button. The password form stays either way — it is what gets you back in when
# the directory is unreachable, and the only way in for the bootstrap admin.
#
# Nothing in the code names a vendor. OpenText Directory Services is what this
# was built against, but OTDS is an ordinary OIDC authorization server and so is
# every alternative — Entra ID, Okta, Keycloak, Ping, Auth0. Pointing this at a
# different one is a change to the values below and to nothing else.
#
# With your provider, register an OAuth client for this application and give it
# the redirect URL below. Then describe it here in one of two ways:
#
#   Discovery (preferred) — set SSO_ISSUER_URI alone. The endpoints, the JWKS
#     location and the signing algorithms are read from
#     {issuer}/.well-known/openid-configuration when the app starts, so a
#     provider upgrade that moves a path costs you no config change.
#
#   Explicit — set SSO_AUTHORIZATION_URI and SSO_TOKEN_URI (plus SSO_JWK_SET_URI
#     or SSO_USER_INFO_URI). Nothing is fetched. Use this for a provider that
#     publishes no discovery document, or when the browser and this service
#     reach it under different host names.
#
# NOTE: this is authentication only. Everyone who signs in through a directory
# gets SSO_DEFAULT_ROLES; directory groups are not read, and roles are changed
# from the admin screen.
# -----------------------------------------------------------------------------
# SSO_ENABLED=true

# Skips the button: the sign-in screen leaves for the provider on its own, before anyone clicks
# anything. This is the deployment's choice, not each visitor's — it does not remove the password
# form, only the button next to it; the frontend keeps a deliberately quiet "sign in with a
# password instead" link, because a directory outage must not also strand the bootstrap
# administrator, who exists in no directory. Ignored while SSO_ENABLED is not also true.
# SSO_ENFORCED=true

# Short id used in URLs, not shown to anyone. It is the last segment of the
# redirect URL, so changing it means re-registering that URL with the provider.
# Both of these default to OTDS, so an OTDS deployment sets neither.
# SSO_PROVIDER_ID=otds
# SSO_PROVIDER_NAME=OpenText

# --- Discovery ---
# SSO_ISSUER_URI=https://otds.example.com/otdsws/oauth2

# --- The OAuth client registered with the provider ---
# SSO_CLIENT_ID=confluence-chatbot
# SSO_CLIENT_SECRET=the-secret-the-provider-generated

# Must match the redirect URL registered against that client, character for
# character. Leave it unset and it is built from the URL the browser used —
# https://your-backend-host/api/login/oauth2/code/<SSO_PROVIDER_ID> — which is
# what to register. This is always the *backend's* own host: the frontend is a
# separate origin, reached at its own URL, not through this service.
# SSO_REDIRECT_URI=https://api.bot.example.com/api/login/oauth2/code/otds

# openid is required — without it the provider returns no ID token and there is
# no verified identity to provision an account from.
# SSO_SCOPES=openid,profile,email
# SSO_CLIENT_AUTHENTICATION_METHOD=client_secret_basic   # or client_secret_post, none

# --- Explicit endpoints (only when not using discovery) ---
# OTDS paths differ between releases and between on-premises and the OpenText
# cloud, so read them off your own server. Try
# {OTDS_BASE}/otdsws/oauth2/.well-known/openid-configuration first — if it
# answers, use discovery and skip this block.
# SSO_AUTHORIZATION_URI=https://otds.example.com/otdsws/oauth2/auth
# SSO_TOKEN_URI=https://otds.example.com/otdsws/oauth2/token
# SSO_JWK_SET_URI=https://otds.example.com/otdsws/oauth2/jwks
# SSO_USER_INFO_URI=https://otds.example.com/otdsws/oauth2/userinfo

# --- Other providers: the same few lines, pointed elsewhere ---
# Microsoft Entra ID
#   SSO_PROVIDER_ID=entra
#   SSO_PROVIDER_NAME=Microsoft
#   SSO_ISSUER_URI=https://login.microsoftonline.com/<tenant-id>/v2.0
# Okta
#   SSO_PROVIDER_ID=okta
#   SSO_ISSUER_URI=https://<your-org>.okta.com/oauth2/default
# Keycloak
#   SSO_PROVIDER_ID=keycloak
#   SSO_ISSUER_URI=https://kc.example.com/realms/<realm>
# Google Workspace
#   SSO_PROVIDER_ID=google
#   SSO_ISSUER_URI=https://accounts.google.com

# --- Claims ---
# Which claim identifies the person, and which ones are searched, in order, for
# their address. A provider's attribute mapping can put the address under any of
# these, so the second is a list. If sign-in fails with "returned no email
# address", add the claim your provider actually releases.
# SSO_USER_NAME_ATTRIBUTE=sub
# SSO_EMAIL_CLAIMS=email,mail,upn,preferred_username

# --- Local behaviour ---
# SSO_DEFAULT_ROLES=USER                  # roles for an account created on first sign-in
# SSO_CODE_TTL=PT1M                       # life of the single-use hand-off code

# This service's own externally-reachable origin, pinned literally. Left unset, the "Continue
# with ..." URL is worked out from the request that asked for it, which only comes out right if
# every proxy between the browser and this service adds correct X-Forwarded-Host and
# X-Forwarded-Proto headers. A proxy that instead forwards the request with its own upstream
# target as the Host header (a common misconfiguration) breaks that derivation silently, handing
# the browser a URL only reachable from inside the proxy's own network — e.g.
# http://localhost:8092/... instead of the address people actually type in. If you see that,
# either fix the proxy's forwarded headers or pin this instead:
# SSO_PUBLIC_BASE_URL=https://api.bot.example.com
# Behind a path-prefixing proxy (matching SSO_REDIRECT_URI's path), include the prefix:
# SSO_PUBLIC_BASE_URL=https://api.bot.example.com/confluencebot-backend

# Where the browser lands with its one-time code — always the UI's own absolute
# URL, since the UI is never on this service's origin. Include VITE_BASE_PATH if
# the UI is published under a sub-path:
# SSO_LOGIN_SUCCESS_URI=https://ui.bot.example.com/sso/callback
# SSO_LOGIN_SUCCESS_URI=https://ui.bot.example.com/ot-confluence-bot/sso/callback

# The provider's end-session endpoint. Set it and signing out ends that session
# too, so the next sign-in asks for credentials instead of silently returning the
# same person. Without it, "sign out" only ends the session in this app.
#
# The frontend tells this endpoint (via the standard post_logout_redirect_uri
# parameter) to send the browser back to this app's own sign-in screen with the
# password form already requested — so "sign out" lands here instead of on
# whatever page the provider shows by default, and an SSO_ENFORCED deployment
# does not immediately leave for the provider again. Bake in a
# post_logout_redirect_uri yourself only to send the browser somewhere else
# instead; it is left untouched when already present.
# SSO_LOGOUT_URI=https://otds.example.com/otdsws/logout

# How X-Forwarded-* headers are treated. Defaults to "framework", required
# whenever anything (a load balancer, an ingress, a TLS-terminating proxy) sits
# in front of this service — otherwise it builds an http:// redirect URI, and an
# authorizationUrl on the wrong host or path, that the provider and the browser
# both get wrong. Set to "none" only when the backend is reached directly with
# nothing in front of it.
# FORWARD_HEADERS_STRATEGY=framework

# -----------------------------------------------------------------------------
# Frontend (baked into the React build as Vite build-time args)
# Docker Compose passes these as --build-arg to the frontend image.
# For local Vite dev: copy to frontend/.env
# -----------------------------------------------------------------------------
# The backend's own absolute URL, /api included. The bundled nginx serves only static files and
# proxies nothing, so this always has to be a URL the browser can reach directly — a relative
# "/api" only works if something else puts the UI and the API on one origin, which nothing here
# does. For the default docker-compose setup, that's the backend's published host port:
VITE_API_BASE=http://localhost:8080/api
VITE_APP_TITLE=Satya's Confluence Agent

# Path the built app is served from. Leave unset (defaults to /) for this Docker/nginx setup.
# Set it when publishing the same frontend to a sub-path elsewhere, e.g. a GitLab Pages project
# site: VITE_BASE_PATH=/karavindasar/ot-confluence-bot/
# VITE_BASE_PATH=/

# Optional — override the host port Docker Compose binds (default 3000)
# FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Mail (used for password reset / invite flows — planned for MVP2)
# All optional — unset MAIL_HOST/USERNAME/PASSWORD just means those emails fail to send.
# MAIL_SMTP_AUTH/MAIL_STARTTLS_* let you point at a relay that doesn't require AUTH or TLS
# (e.g. an internal SMTP relay) instead of an authenticated provider like Gmail — set both
# to false and leave MAIL_USERNAME/MAIL_PASSWORD unset in that case.
# -----------------------------------------------------------------------------
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=your-email@gmail.com
# Display name shown alongside MAIL_FROM, e.g. "Confluence Bot". Defaults to "Confluence Bot".
# MAIL_FROM_NAME=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS_ENABLE=true
# MAIL_STARTTLS_REQUIRED=true

# Public URL of the frontend, included as a sign-in link in onboarding emails. Leave unset to
# omit that line.
# APP_BASE_URL=https://bot.yourcompany.com

# Product name shown in onboarding emails (subject, heading, sign-in button). Defaults to
# VITE_APP_TITLE above, so the two normally stay in sync automatically — only set this if the
# email should show a different name than the UI.
# APP_NAME=
