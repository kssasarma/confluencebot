# The backend's own absolute URL, /api included — the bundled nginx serves only static files, so
# this has to be a URL the browser can reach directly (e.g. http://localhost:8080/api for local
# Vite dev, or the backend's public URL in any other deployment).
VITE_API_BASE=http://localhost:8080/api
VITE_APP_TITLE=Satya's Confluence Agent

# Path the built app is served from. Leave unset (or '/') for a normal root deployment
# (Docker/nginx). Set it when publishing to a sub-path, e.g. a GitLab Pages project site:
# VITE_BASE_PATH=/karavindasar/ot-confluence-bot/
VITE_BASE_PATH=/
